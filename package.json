{
  "name": "hollow-knight-map-cn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && tsx --test tests/rendered-html.test.mjs tests/save-parser.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
    ,"desktop:web": "DESKTOP_BUILD=1 next build"
    ,"desktop:pack:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "aes-js": "3.1.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "electron": "42.8.0",
    "electron-builder": "26.15.7",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "cn.hollowknight.map.test",
    "productName": "空洞骑士地图客户端（测试版）",
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": ["zh-CN", "en-US"],
    "extraMetadata": {
      "dependencies": {}
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Hollow-Knight-Map-Test-${version}-Windows-x64-Portable.${ext}"
    }
  }
}
